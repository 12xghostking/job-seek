# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/job-seek?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Render Free-Tier Keep-Alive Configuration
# Set HEALTH_CHECK_URL to your deployed Render URL to activate the 14-min keep-alive ping
HEALTH_CHECK_URL=
HEALTH_CHECK_INTERVAL_MINUTES=14
